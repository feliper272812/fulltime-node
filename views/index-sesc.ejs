<!doctype html>
<html lang="pt-br" data-bs-theme="auto">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>SESC - RS</title>

        <!-- ////////////////////////////////////////////////////////////////////////////////// -->
        <!-- Required meta tags -->
        <!-- ////////////////////////////////////////////////////////////////////////////////// -->
         
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- ////////////////////////////////////////////////////////////////////////////////// -->
        <!-- SCRIPT OFICIAL DE TEMAS BOOTSTRAP 5.3 -->
        <!-- ////////////////////////////////////////////////////////////////////////////////// -->

        <script src="/js/color-modes.js"></script>

        <!-- ////////////////////////////////////////////////////////////////////////////////// -->
        <!-- Bootstrap CSS v5.3.8 -->
        <!-- ////////////////////////////////////////////////////////////////////////////////// -->

    <!-- BOOTSTRAP 5.3.3 CSS (CDN oficial) -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous"> -->

    <!-- BOOTSTRAP 5.3.3 CSS LOCAL -->
    <link id="bootstrap-css-local" href="/css/bootstrap.min.css" rel="stylesheet">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let cssCarregado = false;
            for (let i = 0; i < document.styleSheets.length; i++) {
                try {
                    let sheet = document.styleSheets[i];
                    if (sheet.href && sheet.href.indexOf("bootstrap.min.css") !== -1) {
                        if (sheet.cssRules && sheet.cssRules.length > 0) {
                            cssCarregado = true;
                            break;
                        }
                    }
                } catch (e) {
                    // Captura restrições de segurança de CORS se houverem
                }
            }

            if (!cssCarregado) {
                alert('bootstrap.min.css local não carregou. Usando CDN como reserva.');
                console.warn('bootstrap.min.css local não carregou. Usando CDN como reserva.');
                
                let cdn = document.createElement("link");
                cdn.rel = "stylesheet";
                cdn.href = "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
                cdn.integrity = "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH";
                cdn.crossOrigin = "anonymous";
                document.head.appendChild(cdn);
            }
        });
    </script>
 
        <!-- ////////////////////////////////////////////////////////////////////////////////// -->
        <!-- CONTROLE DE TEMA IMEDIATO (Renderização ultrarrápida antes do carregamento do DOM) -->
        <!-- ////////////////////////////////////////////////////////////////////////////////// -->

        <script>
            (() => {
                const getStoredTheme = () => localStorage.getItem('theme');
                const getSystemTheme = () => window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                const resolveTheme = (tema) => tema === 'auto' ? getSystemTheme() : tema;
                document.documentElement.setAttribute('data-bs-theme', resolveTheme(getStoredTheme() || 'auto'));
            })();
        </script>

</head>
<body>

  <header>

  <!-- //////////////////////////////////////////////////////////////////////////////////-->
  <!-- ///////      BARRA DE NAVEGAÇÃO FIXA (NAVBAR) /////////////////////////////////// -->
  <!-- //////////////////////////////////////////////////////////////////////////////////-->

    <%- include('partials/nav-sistema') %>

  <!-- ///////////////////////////////////////////////////////////////////////////////// -->

  </header>


<!-- ////////////////////////////////////////////////////////////////////////////////////////////////// -->

  <main class="container">
    <br>
    <h3 class="lead text-center"> SESC - RS</h3>
    <br>
  </main>

  <!-- ================================================================================= -->
  <!-- LOGOTIPO 3D GIRANDO COMO RETÂNGULO -->
  <!-- ================================================================================= -->
  <style>
    .coin-container {
      display: flex;
      justify-content: center;
      align-items: center;
      perspective: 1200px;
      margin-top: 20px;
      margin-bottom: 20px;
    }

    /* ========================================================================= */
    /* LOGOTIPO EM BLOCO RETANGULAR */
    /* ========================================================================= */
    .coin {
      /* Removeu o tamanho fixo quadrado para permitir o formato retangular original */
      display: inline-block;
      transform-style: preserve-3d;
      animation: girarMoeda 6s linear infinite;
      will-change: transform;
      filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.35));
    }

    /* ========================================================================= */
    /* IMAGEM DO RETÂNGULO */
    /* ========================================================================= */
    .coin img {
      /* Mantém a proporção e exibe toda a imagem em seu tamanho original */
      max-width: 70%;
      height: auto;
      /* Removeu o border-radius de 50% para ficar retangular */
      border-radius: 0%; 
      object-fit: contain;
      background: transparent;
    }

    /* ========================================================================= */
    /* ANIMAÇÃO 3D */
    /* ========================================================================= */
    @keyframes girarMoeda {
      0% { transform: rotateY(0deg); }
      50% { transform: rotateY(180deg); }
      100% { transform: rotateY(360deg); }
    }
  </style>

  <!-- ========================================================================= -->
  <!-- CONTAINER DO RETÂNGULO -->
  <!-- ========================================================================= -->
  <div class="coin-container">
    <!-- O bloco de rotação agora envolve diretamente a imagem para evitar quebras de perspectiva -->
    <div class="coin text-center" style="max-width: 50%;">
      <img src="/imagens/Logotipos/sesc-transparente.png" alt="Logotipo Sesc" class="img-fluid" style="mix-blend-mode: multiply;">
    </div>
  </div>

<!-- //////////////////////////////////////////////////////// -->
<!-- FIM DO LOGOTIPO 3D GIRANDO                               -->
<!-- //////////////////////////////////////////////////////// -->


    <!-- //////////////////////////////////////////////////////// -->
    <!-- RODAPÉ FIXO (FOOTER) -->
    <!-- //////////////////////////////////////////////////////// -->

    <%- include('partials/footer') %>

    <!-- /////////////////////////////////////////// -->
    <!-- DEPENDÊNCIAS DE SCRIPTS DO ECOSSISTEMA CORE -->
    <!-- /////////////////////////////////////////// -->

    <script src="/js/bootstrap.bundle.min.js"></script>

    <script>
        // CORREÇÃO: Fallback estável apontando para o arquivo completo do Bootstrap JS na jDelivr oficial
        if (typeof bootstrap === 'undefined') {
            alert('bootstrap.bundle.min.js local não carregou. Usando CDN como reserva.');
            console.warn('bootstrap.bundle.min.js local não carregou. Usando CDN como reserva.');
            document.write('src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"><\/script>');
        }
    </script>

<!-- //////////////////////////////////////////////////////// -->
<!-- iNCLUDE PARA USART HTML EXTERNO -->
<!-- //////////////////////////////////////////////////////// -->

</body>
</html>
