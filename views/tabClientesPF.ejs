<!doctype html>
<html lang="pt-BR" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Clientes Pessoa Física</title>
    <script src="/js/color-modes.js"></script>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100%; padding: 72px 0 56px; background: #f5f7fb; }
        [data-bs-theme="dark"] body { background: #121414; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,.08); }
        .table-scroll { max-height: calc(100vh - 300px); overflow: auto; }
        .table-scroll table { min-width: 2200px; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <main class="container-fluid">
        <div class="card card-custom border-0">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0 text-center">Tabela de Clientes Pessoa Física</h3>
            </div>
            <div class="card-body">
                <% if (mensagem) { %><div class="alert alert-success" role="status"><%= mensagem %></div><% } %>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <a class="btn btn-success btn-sm" href="/clientes-pf/novo">🆕 Novo</a>
                    <a class="btn btn-outline-success btn-sm" href="/clientes-pf/exportar.csv">📊 CSV</a>
                    <span class="badge text-bg-secondary">Total: <strong><%= clientes.length %></strong></span>
                    <form class="input-group input-group-sm ms-md-auto" action="/clientes-pf" method="get" style="max-width:420px">
                        <input name="q" type="search" class="form-control" placeholder="Nome, CPF, nascimento ou rua" value="<%= busca || '' %>" aria-label="Pesquisar clientes">
                        <button class="btn btn-outline-success" type="submit">🔍</button>
                    </form>
                </div>

                <% if (clientes.length === 0) { %>
                    <div class="alert alert-info mb-0">
                        Nenhum cliente encontrado. <a href="/clientes-pf/novo">Cadastrar agora</a>
                    </div>
                <% } else { %>
                    <div class="table-responsive table-scroll shadow rounded border bg-body">
                        <table class="table table-striped table-hover table-sm align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th><th>Ações</th><th>Nome</th><th>CPF</th><th>Data Nasc.</th><th>RG</th><th>Sexo</th>
                                    <th>Telefone</th><th>Celular</th><th>E-mail</th><th>CEP</th><th>Rua</th><th>Número</th>
                                    <th>Bairro</th><th>Cidade</th><th>Estado</th><th>Observações</th><th>Cadastro</th><th>Alteração</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% clientes.forEach(cliente => { %>
                                    <tr>
                                        <td><%= cliente.id %></td>
                                        <td class="text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary py-0" href="/clientes-pf/<%= cliente.id %>/editar">Editar</a>
                                            <form class="d-inline" method="post" action="/clientes-pf/<%= cliente.id %>/excluir" onsubmit="return confirm('Excluir este cliente? Esta ação não pode ser desfeita.')">
                                                <button class="btn btn-sm btn-outline-danger py-0" type="submit">Excluir</button>
                                            </form>
                                        </td>
                                        <td class="text-nowrap"><%= cliente.nomeCompleto %></td>
                                        <td class="text-nowrap"><%= cliente.cpf %></td>
                                        <td class="text-nowrap"><%= formatarDataBR(cliente.dataNascimento) %></td>
                                        <td><%= cliente.rg %></td>
                                        <td><%= cliente.sexo %></td>
                                        <td><%= cliente.telefone %></td>
                                        <td><%= cliente.celular %></td>
                                        <td><%= cliente.email %></td>
                                        <td><%= cliente.cep %></td>
                                        <td><%= cliente.rua %></td>
                                        <td><%= cliente.numero %></td>
                                        <td><%= cliente.bairro %></td>
                                        <td><%= cliente.cidade %></td>
                                        <td><%= cliente.estado %></td>
                                        <td class="text-truncate" style="max-width:180px" title="<%= cliente.observacoes %>"><%= cliente.observacoes %></td>
                                        <td class="text-nowrap"><%= formatarDataBR(cliente.dataCadastro) %></td>
                                        <td class="text-nowrap"><%= formatarDataBR(cliente.dataAlteracao) %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
