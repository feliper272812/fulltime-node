    <!-- AJUSTE DO ESPAÇO DA NAV E DO RODAPÉ -->
    <script>
        (function () {
            const raiz = document.documentElement.style;

            function medirLayout() {
                const nav = document.querySelector('#nav-sistema-placeholder nav, #nav-sistema-placeholder .navbar');
                const rodape = document.querySelector('#footer-placeholder footer, #footer-placeholder > *');

                if (nav) {
                    const fixo = getComputedStyle(nav).position === 'fixed';
                    raiz.setProperty('--nav-h', fixo ? Math.ceil(nav.getBoundingClientRect().bottom) + 'px' : '0px');
                }
                if (rodape) {
                    const fixo = getComputedStyle(rodape).position === 'fixed';
                    raiz.setProperty('--footer-h', fixo ? Math.ceil(window.innerHeight - rodape.getBoundingClientRect().top) + 'px' : '0px');
                }
            }

            let agendado = false;
            function agendarMedicao() {
                if (agendado) return;
                agendado = true;
                requestAnimationFrame(() => { agendado = false; medirLayout(); });
            }

            ['nav-sistema-placeholder', 'footer-placeholder'].forEach(id => {
                const el = document.getElementById(id);
                if (el) new MutationObserver(agendarMedicao).observe(el, { childList: true, subtree: true });
            });

            window.addEventListener('resize', agendarMedicao);
            window.addEventListener('load', agendarMedicao);

            document.addEventListener('DOMContentLoaded', () => {
                agendarMedicao();
            });
        })();
    </script>

    <!-- MOTOR DE IA TURBO (SUPORTE A PNG ESTÁTICO E GIF ANIMADO) -->
    <script type="module">
        const URL_IA     = "https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.7.0/+esm";
        const URL_GIFUCT = "https://cdn.jsdelivr.net/npm/gifuct-js@2.1.2/+esm";
        const URL_GIFENC = "https://cdn.jsdelivr.net/npm/gifenc@1.0.3/+esm";

        const MAX_LADO_GIF = 420;
        let dispositivoAtual = (typeof navigator !== "undefined" && "gpu" in navigator) ? "gpu" : "cpu";

        // Modelo ideal para cada motor: "medium" (fp16) é o que roda bem no WebGPU;
        // "small" (quantizado uint8) é bom na CPU, mas na GPU pode ficar extremamente lento.
        const MODELO_POR_DISPOSITIVO = { gpu: "medium", cpu: "small" };

        const inputArquivo       = document.getElementById("inputImagemOriginal");
        const imgOriginalTag     = document.getElementById("imgOriginalTag");
        const txtPlaceholderOrig = document.getElementById("txtPlaceholderOrig");
        const imgResultadoTag    = document.getElementById("imgResultadoTag");
        const txtPlaceholderRest = document.getElementById("txtPlaceholderRest");
        const loadingOverlay     = document.getElementById("loadingOverlay");
        const txtProgresso       = document.getElementById("txtProgresso");
        const barraAcoes         = document.getElementById("barraAcoesResultado");
        const btnDownload        = document.getElementById("btnDownloadPng");
        const btnLimpar          = document.getElementById("btnLimpar");

        let urlOriginal = null;
        let urlResultado = null;
        let tokenAtual = 0;
        let ticker = null;

        // ---------------------------------------------------------------
        // PROGRESSO
        // A biblioteca guarda (memoize) a configuração da PRIMEIRA chamada, inclusive o callback
        // de progresso. Por isso o callback é único e lê este estado, em vez de depender de
        // variáveis locais de cada quadro (antes, ele sobrescrevia o texto "Quadro X de N").
        // ---------------------------------------------------------------
        const progresso = { fase: "init", detalhe: "Carregando motor de IA...", pct: null, quadro: 0, total: 0, inicio: 0, duracoes: [] };

        const NOMES_RECURSO = (chave) =>
            chave.includes("/models/") ? "modelo de IA" :
            chave.endsWith(".wasm")    ? "motor WASM"   :
            chave.endsWith(".mjs")     ? "motor JS"     : chave;

        const NOMES_ETAPA = {
            "compute:decode":    "lendo imagem",
            "compute:inference": "inferência da IA",
            "compute:mask":      "aplicando máscara",
            "compute:encode":    "gerando saída"
        };

        function formatarTempo(seg) {
            return seg >= 60 ? `${Math.floor(seg / 60)} min ${seg % 60} s` : `${seg} s`;
        }

        function renderProgresso() {
            const modo = dispositivoAtual.toUpperCase();
            let txt;

            if (progresso.fase === "fetch") {
                txt = `Baixando ${progresso.detalhe} (${modo}): ${progresso.pct}% — só na 1ª vez`;
            } else if (progresso.fase === "compute") {
                const decorrido = Math.floor((Date.now() - progresso.inicio) / 1000);
                txt = progresso.total > 1
                    ? `[${modo}] Quadro ${progresso.quadro} de ${progresso.total} — ${progresso.detalhe} · ${formatarTempo(decorrido)}`
                    : `Processando (${modo}) — ${progresso.detalhe} · ${formatarTempo(decorrido)}`;

                const d = progresso.duracoes.slice(-5);
                if (progresso.total > 1 && d.length) {
                    const media = d.reduce((a, b) => a + b, 0) / d.length;
                    txt += ` · restam ~${formatarTempo(Math.round(media * (progresso.total - progresso.quadro) / 1000))}`;
                }
            } else {
                txt = progresso.detalhe;
            }
            txtProgresso.textContent = txt;
        }

        function definirStatus(texto) {
            progresso.fase = "init";
            progresso.detalhe = texto;
            renderProgresso();
        }

        function aoProgredir(chave, atual, total) {
            if (chave.startsWith("fetch:")) {
                progresso.fase = "fetch";
                progresso.detalhe = NOMES_RECURSO(chave);
                progresso.pct = total ? Math.round(atual / total * 100) : 0;
            } else {
                progresso.fase = "compute";
                progresso.detalhe = NOMES_ETAPA[chave] || chave;
            }
            renderProgresso();
        }

        function iniciarTicker() {
            pararTicker();
            ticker = setInterval(renderProgresso, 1000);
        }

        function pararTicker() {
            if (ticker) { clearInterval(ticker); ticker = null; }
        }

        function liberarUrls() {
            if (urlOriginal)  { URL.revokeObjectURL(urlOriginal);  urlOriginal = null; }
            if (urlResultado) { URL.revokeObjectURL(urlResultado); urlResultado = null; }
        }

        function ehGif(arquivo) {
            return arquivo.type === "image/gif" || /\.gif$/i.test(arquivo.name);
        }

        function canvasParaBlobRapido(canvas) {
            return new Promise((resolve) => canvas.toBlob(resolve, "image/webp", 0.9));
        }

        async function executarIAResistente(removeBackground, entrada, opcoesExtra = {}) {
            try {
                return await removeBackground(entrada, {
                    device: dispositivoAtual,
                    model: MODELO_POR_DISPOSITIVO[dispositivoAtual],
                    ...opcoesExtra,
                    progress: aoProgredir
                });
            } catch (err) {
                if (dispositivoAtual === "gpu") {
                    console.warn("WebGPU falhou neste hardware, alternando para CPU:", err);
                    dispositivoAtual = "cpu";
                    definirStatus("WebGPU falhou neste hardware — alternando para CPU...");
                    return await removeBackground(entrada, {
                        device: "cpu",
                        model: MODELO_POR_DISPOSITIVO.cpu,
                        ...opcoesExtra,
                        progress: aoProgredir
                    });
                }
                throw err;
            }
        }
        // ---------------------------------------------------------------
        // PRESERVAR ÁREAS ESCURAS
        // A IA confunde partes escuras do objeto com o fundo preto (ex.: lado escuro da Terra no
        // espaço) e as apaga. Solução: a IA analisa uma CÓPIA com as sombras clareadas (gama), mas a
        // máscara (alpha) resultante é aplicada sobre as cores ORIGINAIS da imagem.
        // ---------------------------------------------------------------
        const GAMA_REALCE = 0.5;
        const LUT_REALCE = Uint8ClampedArray.from({ length: 256 }, (_, i) => Math.round(255 * Math.pow(i / 255, GAMA_REALCE)));
        const chkRealce = document.getElementById("chkRealceEscuros");

        function canvasParaBlobPng(canvas) {
            return new Promise((resolve) => canvas.toBlob(resolve, "image/png"));
        }

        async function removerFundoRGBA(removeBackground, blobOriginal) {
            const bmp = await createImageBitmap(blobOriginal);
            const w = bmp.width;
            const h = bmp.height;

            const cv = document.createElement("canvas");
            cv.width = w; cv.height = h;
            const ctx = cv.getContext("2d", { willReadFrequently: true });
            ctx.drawImage(bmp, 0, 0);
            if (bmp.close) bmp.close();

            const original = ctx.getImageData(0, 0, w, h);
            const px = original.data;

            let entradaIA = blobOriginal;
            if (chkRealce.checked) {
                const clareado = new ImageData(new Uint8ClampedArray(px), w, h);
                const d = clareado.data;
                for (let i = 0; i < d.length; i += 4) {
                    d[i]     = LUT_REALCE[d[i]];
                    d[i + 1] = LUT_REALCE[d[i + 1]];
                    d[i + 2] = LUT_REALCE[d[i + 2]];
                }
                ctx.putImageData(clareado, 0, 0);
                entradaIA = await canvasParaBlobPng(cv);
            }

            const blobIA = await executarIAResistente(removeBackground, entradaIA, {
                output: { format: "image/x-rgba8" }
            });
            const ia = new Uint8ClampedArray(await blobIA.arrayBuffer());
            if (ia.length !== px.length) {
                throw new Error("O tamanho da máscara da IA é diferente do da imagem original.");
            }

            // cores ORIGINAIS + transparência (alpha) calculada pela IA
            for (let i = 3; i < px.length; i += 4) px[i] = ia[i];
            return { data: px, w, h };
        }

        async function removerFundoPNG(removeBackground, arquivo) {
            if (!chkRealce.checked) {
                return await executarIAResistente(removeBackground, arquivo, {
                    output: { format: "image/png" }
                });
            }
            const { data, w, h } = await removerFundoRGBA(removeBackground, arquivo);
            const cv = document.createElement("canvas");
            cv.width = w; cv.height = h;
            cv.getContext("2d").putImageData(new ImageData(data, w, h), 0, 0);
            return await canvasParaBlobPng(cv);
        }

        async function extrairQuadrosGif(arquivo, parseGIF, decompressFrames) {
            const gif = parseGIF(await arquivo.arrayBuffer());
            const frames = decompressFrames(gif, true);
            const W = gif.lsd.width;
            const H = gif.lsd.height;

            const escala = Math.min(1, MAX_LADO_GIF / Math.max(W, H));
            const w = Math.max(1, Math.round(W * escala));
            const h = Math.max(1, Math.round(H * escala));

            const tela = document.createElement("canvas");
            tela.width = W; tela.height = H;
            const ctx = tela.getContext("2d", { willReadFrequently: true });

            const saida = document.createElement("canvas");
            saida.width = w; saida.height = h;
            const ctxSaida = saida.getContext("2d");

            const remendo = document.createElement("canvas");
            const ctxRemendo = remendo.getContext("2d");

            const quadros = [];
            let dimsAnterior = null;
            let descarteAnterior = 0;
            let estadoRestaurar = null;

            for (const f of frames) {
                if (descarteAnterior === 2 && dimsAnterior) {
                    ctx.clearRect(dimsAnterior.left, dimsAnterior.top, dimsAnterior.width, dimsAnterior.height);
                } else if (descarteAnterior === 3 && estadoRestaurar) {
                    ctx.putImageData(estadoRestaurar, 0, 0);
                }
                estadoRestaurar = f.disposalType === 3 ? ctx.getImageData(0, 0, W, H) : null;

                remendo.width = f.dims.width;
                remendo.height = f.dims.height;
                ctxRemendo.putImageData(new ImageData(f.patch, f.dims.width, f.dims.height), 0, 0);
                ctx.drawImage(remendo, f.dims.left, f.dims.top);

                ctxSaida.clearRect(0, 0, w, h);
                ctxSaida.drawImage(tela, 0, 0, w, h);

                quadros.push({ blob: await canvasParaBlobRapido(saida), atraso: f.delay || 100 });

                dimsAnterior = f.dims;
                descarteAnterior = f.disposalType;
            }
            return { quadros, largura: w, altura: h };
        }

        async function processarGif(arquivo, token, removeBackground) {
            definirStatus("Carregando módulos de GIF...");
            const [{ parseGIF, decompressFrames }, { GIFEncoder, quantize, applyPalette }] = await Promise.all([
                import(URL_GIFUCT),
                import(URL_GIFENC)
            ]);

            definirStatus("Extraindo quadros do GIF...");
            const { quadros, largura, altura } = await extrairQuadrosGif(arquivo, parseGIF, decompressFrames);

            if (quadros.length <= 1) {
                progresso.total = 0;
                progresso.inicio = Date.now();
                const blob = await removerFundoPNG(removeBackground, arquivo);
                return { blob, ext: "png" };
            }

            const encoder = GIFEncoder();
            progresso.total = quadros.length;
            progresso.duracoes = [];

            for (let i = 0; i < quadros.length; i++) {
                if (token !== tokenAtual) return null;

                progresso.quadro = i + 1;
                progresso.inicio = Date.now();
                progresso.fase = "compute";
                progresso.detalhe = i === 0 ? "preparando IA" : "iniciando";
                renderProgresso();

                const { data } = await removerFundoRGBA(removeBackground, quadros[i].blob);
                quadros[i].blob = null;

                // o 1º quadro inclui download/criação da sessão, então não entra na estimativa
                if (i > 0) progresso.duracoes.push(Date.now() - progresso.inicio);

                const paleta = quantize(data, 256, { format: "rgba4444", oneBitAlpha: true, useSqrt: false });
                const indices = applyPalette(data, paleta, "rgba4444");
                const idxTransp = paleta.findIndex((c) => c.at(3) === 0);

                encoder.writeFrame(indices, largura, altura, {
                    palette: paleta,
                    delay: quadros[i].atraso,
                    transparent: idxTransp >= 0,
                    transparentIndex: idxTransp >= 0 ? idxTransp : 0,
                    dispose: 2,
                    repeat: 0
                });
            }

            encoder.finish();
            return { blob: new Blob([encoder.bytes()], { type: "image/gif" }), ext: "gif" };
        }

        async function processarRemocaoFundo(arquivo) {
            const token = ++tokenAtual;
            liberarUrls();

            urlOriginal = URL.createObjectURL(arquivo);
            imgOriginalTag.src = urlOriginal;
            imgOriginalTag.classList.remove("d-none");
            txtPlaceholderOrig.classList.add("d-none");

            imgResultadoTag.classList.add("d-none");
            imgResultadoTag.removeAttribute("src");
            txtPlaceholderRest.textContent = "Aguardando processamento...";
            txtPlaceholderRest.classList.remove("d-none");
            loadingOverlay.classList.remove("d-none");
            progresso.total = 0;
            progresso.duracoes = [];
            definirStatus("Carregando motor de IA...");
            iniciarTicker();
            barraAcoes.classList.add("d-none");

            try {
                const { removeBackground } = await import(URL_IA);

                let resultado;
                if (ehGif(arquivo)) {
                    resultado = await processarGif(arquivo, token, removeBackground);
                } else {
                    progresso.total = 0;
                    progresso.inicio = Date.now();
                    const blob = await removerFundoPNG(removeBackground, arquivo);
                    resultado = { blob, ext: "png" };
                }

                if (!resultado || token !== tokenAtual) return;

                urlResultado = URL.createObjectURL(resultado.blob);
                imgResultadoTag.src = urlResultado;
                imgResultadoTag.classList.remove("d-none");
                txtPlaceholderRest.classList.add("d-none");

                btnDownload.textContent = `💾 Download ${resultado.ext.toUpperCase()}`;
                btnDownload.onclick = () => {
                    const a = document.createElement("a");
                    a.href = urlResultado;
                    a.download = `fulltime_prod_${Date.now()}_sem_fundo.${resultado.ext}`;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                };

                barraAcoes.classList.remove("d-none");

            } catch (erro) {
                if (token !== tokenAtual) return;
                console.error(erro);
                alert("Falha no processamento da IA:\n" + erro.message);
                txtPlaceholderRest.textContent = "Erro no processamento da imagem.";
            } finally {
                if (token === tokenAtual) { pararTicker(); loadingOverlay.classList.add("d-none"); }
            }
        }

        function resetarPainel() {
            tokenAtual++;
            pararTicker();
            liberarUrls();
            inputArquivo.value = "";
            imgOriginalTag.classList.add("d-none");
            imgOriginalTag.removeAttribute("src");
            txtPlaceholderOrig.classList.remove("d-none");
            imgResultadoTag.classList.add("d-none");
            imgResultadoTag.removeAttribute("src");
            txtPlaceholderRest.textContent = "Aguardando processamento...";
            txtPlaceholderRest.classList.remove("d-none");
            loadingOverlay.classList.add("d-none");
            barraAcoes.classList.add("d-none");
        }

        inputArquivo.addEventListener("change", (e) => {
            const arquivo = e.target.files && e.target.files.item(0);
            if (arquivo) processarRemocaoFundo(arquivo);
        });

        btnLimpar.addEventListener("click", resetarPainel);
    </script>

</body>
</html>
