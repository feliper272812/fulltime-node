    <!-- ////////////////////////////////////////////////////////////////////////////////// -->
    <!-- SCRIPT OFICIAL DE TEMAS BOOTSTRAP 5.3 -->
    <!-- ////////////////////////////////////////////////////////////////////////////////// -->

    <script src="/js/color-modes.js"></script>

    <!-- ////////////////////////////////////////////////////////////////////////////////// -->
    <!-- Bootstrap CSS v5.3.8 -->
    <!-- ////////////////////////////////////////////////////////////////////////////////// -->

    <!-- BOOTSTRAP 5.3.3 CSS (CDN oficial) -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous"> -->

    <!-- BOOTSTRAP 5.3.3 CSS LOCAL -->
    <link id="bootstrap-css-local" href="/css/bootstrap.min.css" rel="stylesheet">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let cssCarregado = false;
            for (let i = 0; i < document.styleSheets.length; i++) {
                try {
                    let sheet = document.styleSheets[i];
                    if (sheet.href && sheet.href.indexOf("bootstrap.min.css") !== -1) {
                        if (sheet.cssRules && sheet.cssRules.length > 0) {
                            cssCarregado = true;
                            break;
                        }
                    }
                } catch (e) {
                    // Captura restrições de segurança de CORS se houverem
                }
            }

            if (!cssCarregado) {
                alert('bootstrap.min.css local não carregou. Usando CDN como reserva.');
                console.warn('bootstrap.min.css local não carregou. Usando CDN como reserva.');
                
                    let cdn = document.createElement("link");
                    cdn.rel = "stylesheet";
                    cdn.href = "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css";
                    cdn.integrity = "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH";
                    cdn.crossOrigin = "anonymous";
                    document.head.appendChild(cdn);
                }

        });
        
    </script>
    
    <style>
        html, body { min-height: 100%; overflow-y: auto; }
        body { background-color: #f5f7fb; transition: background-color 0.3s ease; padding-top: 41px; padding-bottom: 40px; }
        [data-bs-theme="dark"] body { background-color: #121212; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,0.08); }
        .titulo-secao { color: var(--bs-success); font-weight: bold; margin-bottom: 20px; }
        .form-label { font-weight: 600; }
        .btn-bd-primary {
            --bd-violet-bg: #712cf9; --bs-btn-font-weight: 600; --bs-btn-color: var(--bs-white);
            --bs-btn-bg: var(--bd-violet-bg); --bs-btn-border-color: var(--bd-violet-bg);
        }
        .preview-image {
            width: 320px; height: 320px; border: 2px solid #198754; border-radius: 12px;
            background: #ffffff; display: flex; align-items: center; justify-content: center;
            overflow: hidden; margin: auto; box-shadow: 0 4px 18px rgba(0,0,0,.15); transition: .30s;
        }
        .preview-image:hover { transform: scale(1.02); }
        .preview-image img { width: 100%; height: 100%; object-fit: contain; }
        #previewImagemPlaceholder { color: #999; font-size: 18px; text-align: center; }
        .colunaFormulario { width: 70%; } .colunaImagem { width: 30%; }
        @media (max-width: 992px) {
            .colunaFormulario { width: 100%; } .colunaImagem { width: 100%; margin-top: 30px; }
            .preview-image { width: 260px; height: 260px; }
        }
    </style>
</head>
