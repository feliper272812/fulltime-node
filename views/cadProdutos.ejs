<!-- ////////////////////////////////////////////////////////////////////////////////////////////////// -->
<!-- ///////      SCRIPTS DE LÓGICA - ENGINE DO BANCO E GESTÃO DE IMAGENS              /////////////// -->
<!-- ////////////////////////////////////////////////////////////////////////////////////////////////// -->

<script>
    let imagemAtualBase64 = document.getElementById('imagemBase64').value ||
        document.getElementById('previewImagemTag').getAttribute('src') || null;
    let imagemAtualNome = document.getElementById('imagemNome').value ||
        document.getElementById('nomeArquivoImagemHidden').value || '';
    let imagemEhLegada = Boolean(imagemAtualBase64 && !document.getElementById('imagemBase64').value);
    let formularioAlterado = false;

    function comprimirImagem(dataUrl, maxLargura = 600, qualidade = 0.8) {
        return new Promise(resolve => {
            const img = new Image();
            img.onload = () => {
                const escala = Math.min(1, maxLargura / img.width);
                const c = document.createElement('canvas');
                c.width = Math.round(img.width * escala);
                c.height = Math.round(img.height * escala);
                const ctx = c.getContext('2d');
                ctx.fillStyle = '#ffffff'; ctx.fillRect(0, 0, c.width, c.height);
                ctx.drawImage(img, 0, 0, c.width, c.height);
                resolve(c.toDataURL('image/jpeg', qualidade));
            };
            img.onerror = () => resolve(dataUrl);
            img.src = dataUrl;
        });
    }

    function handleImagemSelecionada(event) {
        const arquivo = event.target.files[0];
        if (!arquivo) return;
        imagemAtualNome = arquivo.name;

        const reader = new FileReader();
        reader.onload = async function(e) {
            imagemAtualBase64 = await comprimirImagem(e.target.result);
            imagemEhLegada = false;
            exibirPreviewImagem(imagemAtualBase64);
            formularioAlterado = true;
        };
        reader.readAsDataURL(arquivo);
    }

    function exibirPreviewImagem(dataUrl) {
        const placeholder = document.getElementById('previewImagemPlaceholder');
        const tag = document.getElementById('previewImagemTag');
        const btnRemover = document.getElementById('btnRemoverImagem');
        const txtNome = document.getElementById('nomeArquivoImagem');
        if (!tag) return;
        // Caminho inexistente / arquivo quebrado: mostra aviso em vez de ficar em branco
        if (!tag.dataset.erroBind) {
            tag.dataset.erroBind = '1';
            tag.addEventListener('error', () => {
                if (!tag.getAttribute('src')) return;
                tag.classList.add('d-none');
                if (placeholder) { placeholder.textContent = 'Imagem não encontrada'; placeholder.classList.remove('d-none'); }
                if (txtNome) txtNome.textContent = 'Arquivo não encontrado: ' + tag.getAttribute('src').slice(0, 80);
            });
        }
        if (dataUrl) {
            if (placeholder) placeholder.textContent = 'Nenhuma imagem';
            tag.src = dataUrl; tag.classList.remove('d-none');
            placeholder?.classList.add('d-none'); btnRemover?.classList.remove('d-none');
            if(txtNome) txtNome.textContent = imagemAtualNome || "Imagem carregada";
        } else {
            tag.removeAttribute('src'); tag.classList.add('d-none');
            if (placeholder) placeholder.textContent = 'Nenhuma imagem';
            placeholder?.classList.remove('d-none'); btnRemover?.classList.add('d-none');
            if(txtNome) txtNome.textContent = "Nenhuma imagem selecionada";
        }
    }

    function removerImagem() {
        imagemAtualBase64 = null; imagemAtualNome = ''; imagemEhLegada = false;
        if(document.getElementById('inputImagemProduto')) document.getElementById('inputImagemProduto').value = '';
        document.getElementById('imagemBase64').value = '';
        document.getElementById('imagemNome').value = '';
        document.getElementById('localImagem').value = '';
        document.getElementById('nomeArquivoImagemHidden').value = '';
        exibirPreviewImagem(null); formularioAlterado = true;
    }

    let cameraStream = null;
    let modalCameraInstancia = null;
    let cameraListenerOk = false;
    let cameraToken = 0;

    function mensagemErroCamera(err) {
        const nome = err && err.name;
        if (nome === 'NotAllowedError' || nome === 'SecurityError')
            return 'Permissão negada. Ative o acesso à câmera no seu navegador.';
        if (nome === 'NotFoundError' || nome === 'DevicesNotFoundError')
            return 'Nenhuma câmera foi encontrada neste dispositivo.';
        if (nome === 'NotReadableError' || nome === 'TrackStartError')
            return 'A câmera está ocupada por outro programa.';
        return 'Erro: ' + (err && err.message ? err.message : err);
    }

    async function obterStreamCamera() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
            const e = new Error('Câmera indisponível: abra a página por HTTPS ou localhost (ou use o navegador atualizado).');
            e.name = 'InsecureContext';
            throw e;
        }
        const tentativas = [
            { video: { facingMode: { ideal: 'environment' } }, audio: false },
            { video: true, audio: false }
        ];
        let ultimoErro;
        for (const c of tentativas) {
            try { return await navigator.mediaDevices.getUserMedia(c); }
            catch (e) {
                ultimoErro = e;
                if (e && (e.name === 'NotAllowedError' || e.name === 'SecurityError' || e.name === 'NotReadableError')) throw e;
            }
        }
        throw ultimoErro;
    }

    async function abrirCamera() {
        const modalEl = document.getElementById('modalCamera');
        const erroMsg = document.getElementById('erroCameraMsg');
        const video = document.getElementById('videoCamera');
        erroMsg.classList.add('d-none'); erroMsg.textContent = '';

        pararCamera();
        const token = ++cameraToken;

        modalCameraInstancia = bootstrap.Modal.getOrCreateInstance(modalEl);
        if (!cameraListenerOk) {
            modalEl.addEventListener('hidden.bs.modal', pararCamera);
            cameraListenerOk = true;
        }
        modalCameraInstancia.show();

        try {
            const stream = await obterStreamCamera();
            if (token !== cameraToken) { stream.getTracks().forEach(t => t.stop()); return; }
            cameraStream = stream;
            video.srcObject = stream;
            video.muted = true;
            video.play().catch(() => {});
        } catch (err) {
            erroMsg.textContent = mensagemErroCamera(err);
            erroMsg.classList.remove('d-none');
        }
    }

    function pararCamera() {
        cameraToken++;
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }
        const video = document.getElementById('videoCamera');
        if (video) video.srcObject = null;
    }

    function capturarFoto() {
        const video = document.getElementById('videoCamera');
        if (!video || !video.videoWidth) { alert('Câmera não está pronta.'); return; }

        const canvas = document.createElement('canvas');
        const MAX_LARGURA = 600;
        const escala = Math.min(1, MAX_LARGURA / video.videoWidth);
        canvas.width = Math.round(video.videoWidth * escala);
        canvas.height = Math.round(video.videoHeight * escala);
        canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);

        imagemAtualBase64 = canvas.toDataURL('image/jpeg', 0.75);
        imagemEhLegada = false;
        imagemAtualNome = 'foto_camera_' + Date.now() + '.jpg';
        exibirPreviewImagem(imagemAtualBase64);
        formularioAlterado = true;

        if (modalCameraInstancia) modalCameraInstancia.hide();
    }

    let scannerInstancia = null;
    let scannerListenerOk = false;
    let scannerToken = 0;
    let scannerLibPromise = null;

    function carregarScriptExterno(src) {
        return new Promise((resolve, reject) => {
            const sc = document.createElement('script');
            sc.src = src;
            sc.onload = resolve;
            sc.onerror = () => { sc.remove(); reject(new Error('Falha ao carregar ' + src)); };
            document.head.appendChild(sc);
        });
    }

    function carregarLibScanner() {
        if (window.Html5Qrcode) return Promise.resolve();
        if (!scannerLibPromise) {
            scannerLibPromise = carregarScriptExterno('/js/html5-qrcode.min.js')
                .catch(() => carregarScriptExterno('https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js'))
                .then(() => { if (!window.Html5Qrcode) throw new Error('Biblioteca do leitor não inicializou.'); })
                .catch(() => { scannerLibPromise = null; throw new Error('Erro ao carregar biblioteca do leitor.'); });
        }
        return scannerLibPromise;
    }

    async function pararScanner() {
        scannerToken++;
        const inst = scannerInstancia;
        scannerInstancia = null;
        if (!inst) return;
        try { if (inst.isScanning) await inst.stop(); } catch (e) {}
        try { inst.clear(); } catch (e) {}
    }

    async function abrirScanner() {
        const modalEl = document.getElementById('modalScanner');
        const erroMsg = document.getElementById('erroScannerMsg');
        erroMsg.classList.add('d-none'); erroMsg.textContent = '';

        await pararScanner();
        const token = ++scannerToken;

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        if (!scannerListenerOk) {
            modalEl.addEventListener('hidden.bs.modal', pararScanner);
            scannerListenerOk = true;
        }
        modal.show();

        try {
            await carregarLibScanner();
            if (token !== scannerToken) return;

            const F = Html5QrcodeSupportedFormats;
            const inst = new Html5Qrcode('leitorScanner', {
                // Deixe só o que você realmente usa (acrescente CODE_128 se precisar)
                formatsToSupport: [F.EAN_13, F.EAN_8, F.UPC_A, F.UPC_E],
                experimentalFeatures: { useBarCodeDetectorIfSupported: true },
                verbose: false
            });
            scannerInstancia = inst;

            let lido = false;
            const config = {
                fps: 15,
                // Caixa proporcional ao vídeo (larga e baixa, formato de código de barras)
                qrbox: (w, h) => ({
                    width: Math.floor(w * 0.9),
                    height: Math.floor(Math.min(h * 0.5, 180))
                }),
                // Resolução maior e foco contínuo
                videoConstraints: {
                    facingMode: { ideal: 'environment' },
                    width: { ideal: 1280 },
                    height: { ideal: 720 },
                    advanced: [{ focusMode: 'continuous' }]
                }
            };

            await inst.start({ facingMode: 'environment' }, config, function (texto) {
                if (lido) return;
                lido = true;
                console.log('Scanner leu:', texto);   // diagnóstico
                const campo = document.getElementById('codigoBarras');
                campo.value = String(texto).trim();
                campo.dispatchEvent(new Event('input', { bubbles: true }));
                campo.classList.add('is-valid');
                setTimeout(() => campo.classList.remove('is-valid'), 1500);
                modal.hide();
            }, () => {});
        } catch (err) {
            erroMsg.textContent = 'Erro ao iniciar o scanner de câmera: ' + ((err && err.message) || err);
            erroMsg.classList.remove('d-none');
        }
    }
    // =========================================================================
    // MOTOR DE CORREÇÃO COMPLETA PARA O LEITOR DE CÓDIGO DE BARRAS USB
    // =========================================================================
    // ---- MODO LEITOR USB (botão "🔌 Leitor USB"): campo fica aguardando o leitor, sem depender de velocidade ----
    let modoLeitorUSB = false;

    function ativarLeitorUSB() {
        const campo = document.getElementById('codigoBarras');
        if (!campo) return;
        modoLeitorUSB = true;
        campo.value = '';
        campo.dataset.placeholderOriginal = campo.dataset.placeholderOriginal || campo.placeholder;
        campo.placeholder = 'Aguardando leitura... passe o leitor no código';
        campo.classList.remove('is-valid');
        campo.classList.add('border-success', 'border-3');
        campo.focus();
    }

    function desativarLeitorUSB() {
        const campo = document.getElementById('codigoBarras');
        modoLeitorUSB = false;
        if (!campo) return;
        campo.classList.remove('border-success', 'border-3');
        if (campo.dataset.placeholderOriginal) campo.placeholder = campo.dataset.placeholderOriginal;
    }

    (function () {
        const campo = document.getElementById('codigoBarras');
        if (!campo) return;
        campo.addEventListener('keydown', function (e) {
            if (!modoLeitorUSB) return;
            if ((e.key === 'Enter' || e.key === 'Tab') && campo.value.trim()) {
                e.preventDefault();
                e.stopPropagation();
                campo.value = campo.value.trim();
                formularioAlterado = true;
                desativarLeitorUSB();
                campo.classList.add('is-valid');
                setTimeout(() => campo.classList.remove('is-valid'), 1500);
            }
        });
        campo.addEventListener('blur', desativarLeitorUSB);
    })();

    const LEITOR_MAX_INTERVALO_MS = 100;  // leitor digita rápido; humano passa disso
    const LEITOR_MIN_TAMANHO = 4;        // mínimo de caracteres do código
    let bufferCodigoBarras = "";
    let tempoUltimoCaractere = 0;
    let campoAntesDoBurst = null;        // { el, valor } estado do campo antes do 1º caractere

    function resetarBufferLeitor() { bufferCodigoBarras = ""; campoAntesDoBurst = null; }

    // Captura global de entradas rápidas do teclado (comportamento do scanner físico)
    window.addEventListener("keydown", function (e) {
        if (modoLeitorUSB) return; // o próprio campo trata a leitura
        if (e.ctrlKey || e.metaKey || e.altKey) return;
        if (document.querySelector('.modal.show')) return;

        const campoFoco = document.activeElement;
        if (campoFoco && campoFoco.id === "descricao") return;

        const agora = performance.now();
        const intervalo = agora - tempoUltimoCaractere;
        tempoUltimoCaractere = agora;

        // Fim da leitura: Enter (ou Tab, se o leitor estiver configurado assim)
        if (e.key === "Enter" || e.key === "Tab") {
            if (bufferCodigoBarras.length >= LEITOR_MIN_TAMANHO && intervalo <= LEITOR_MAX_INTERVALO_MS) {
                e.preventDefault();
                e.stopPropagation();

                // Desfaz o que o leitor "digitou" no campo que estava em foco
                if (campoAntesDoBurst && campoAntesDoBurst.el) campoAntesDoBurst.el.value = campoAntesDoBurst.valor;

                const inputAlvo = document.getElementById("codigoBarras");
                if (inputAlvo) {
                    inputAlvo.value = bufferCodigoBarras;
                    inputAlvo.dispatchEvent(new Event("input", { bubbles: true }));
                    formularioAlterado = true;
                }
            }
            resetarBufferLeitor();
            return;
        }

        if (e.key.length !== 1) return; // Shift, Backspace, etc.

        if (bufferCodigoBarras === "" || intervalo > LEITOR_MAX_INTERVALO_MS) {
            // Possível início de nova leitura: guarda o valor do campo antes do caractere entrar
            bufferCodigoBarras = e.key;
            campoAntesDoBurst = (campoFoco && 'value' in campoFoco) ? { el: campoFoco, valor: campoFoco.value } : null;
        } else {
            bufferCodigoBarras += e.key;
        }
    }, true);

    // Evita isoladamente que o input envie o form ao receber o Enter final do leitor
    document.getElementById('codigoBarras')?.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            e.stopPropagation();
        }
    });
    function confirmarSalvarProduto() {
        const formulario = document.getElementById('cadProdutos');
        if (!formulario.reportValidity()) return false;
        if (!confirm('Deseja salvar o produto?')) return false;

        document.getElementById('imagemBase64').value = imagemEhLegada ? '' : (imagemAtualBase64 || '');
        if (!imagemEhLegada) {
            document.getElementById('imagemNome').value = imagemAtualNome || '';
            document.getElementById('localImagem').value = '';
            document.getElementById('nomeArquivoImagemHidden').value = '';
        }
        formularioAlterado = false;
        return true;
    }

    function salvarProduto(event) {
        if (event) event.preventDefault();
        document.getElementById('cadProdutos').requestSubmit();
    }

    function carregarProdutoNoForm(id) {
        window.location.href = `/produtos/${encodeURIComponent(id)}/editar`;
    }

    function limparFormulario() {
        window.location.href = '/produtos/novo';
    }

    function novoProduto() { window.location.href = '/produtos/novo'; }

    async function baixarJSON() {
        try {
            const resposta = await fetch('/api/produtos');
            if (!resposta.ok) throw new Error('Não foi possível exportar os produtos.');
            const produtos = await resposta.json();
            const blob = new Blob([JSON.stringify(produtos, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const link = Object.assign(document.createElement('a'), { href: url, download: 'cadProdutos.json' });
            link.click();
            URL.revokeObjectURL(url);
        } catch (erro) {
            alert(erro.message);
        }
    }

    async function pesquisarCodigo() {
        const termo = (document.getElementById('inputCodigo').value || '').trim();
        if (!termo) return;
        try {
            const resposta = await fetch(`/api/produtos?q=${encodeURIComponent(termo)}`);
            if (!resposta.ok) throw new Error('Não foi possível pesquisar produtos.');
            const produtos = await resposta.json();
            if (produtos.length === 0) { alert('Nenhum produto encontrado!'); return; }

            const escaparHTML = valor => String(valor ?? '').replace(/[&<>"']/g, caractere => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[caractere]);
            document.getElementById('modalPesquisaProdutoBody').innerHTML = produtos.map(produto => `
                <div class="card mb-2 small"><div class="card-body">
                    <strong>#${escaparHTML(produto.id)} - ${escaparHTML(produto.nome)}</strong><br>
                    Código: ${escaparHTML(produto.codigo)} | EAN: ${escaparHTML(produto.codigoBarras)}<br>
                    <button class="btn btn-sm btn-success mt-2 py-0" onclick="carregarProdutoNoForm('${escaparHTML(produto.id)}')">✏️ Carregar</button>
                </div></div>`).join('');
            new bootstrap.Modal(document.getElementById('modalPesquisaProduto')).show();
        } catch (erro) {
            alert(erro.message);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        exibirPreviewImagem(imagemAtualBase64);
        if (document.getElementById('codigoBarras').value) document.getElementById('codigoBarras').focus();
        document.getElementById('cadProdutos')?.querySelectorAll('input, select, textarea').forEach(c => {
            if (c.id !== 'inputCodigo' && c.type !== 'hidden') c.addEventListener('input', () => formularioAlterado = true);
        });
    });

    window.addEventListener('beforeunload', e => { if (formularioAlterado) e.returnValue = ''; });

</script>

