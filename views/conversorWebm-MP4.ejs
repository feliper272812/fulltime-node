<!-- =========================================================
  ARQUIVO: conversorWebm-MP4.ejs

  CONVERSOR DE VÍDEO WEBM PARA MP4 NO NAVEGADOR

  Tecnologias:
  - HTML5
  - CSS3
  - Bootstrap 5.3
  - MediaRecorder / Canvas / Web Audio API / Web Worker

  Tema:
  - Light
  - Dark
  - Auto

  Autor: Felipe Rodrigues - FullTime Technology
========================================================= -->

<!doctype html>
<html lang="pt-br" data-bs-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conversor WebM para MP4</title>

    <!-- ///////////////////////////////////////////////////////// -->
    <!--         SCRIPT OFICIAL DE TEMAS BOOTSTRAP 5.3             -->
    <!-- ///////////////////////////////////////////////////////// -->

    <script src="/js/color-modes.js"></script>

    <!-- ///////////////////////////////////////////////////////// -->
    <!-- Controle de tema nativo imediato para evitar flash visual -->
    <!-- ///////////////////////////////////////////////////////// -->

    <script>
        (() => {
            const getStoredTheme = () => localStorage.getItem('theme');
            const getSystemTheme = () => window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            const resolveTheme = (tema) => tema === 'auto' ? getSystemTheme() : tema;
            document.documentElement.setAttribute('data-bs-theme', resolveTheme(getStoredTheme() || 'auto'));
        })();
    </script>

    <!-- BOOTSTRAP 5.3.3 CSS LOCAL -->
    <link id="bootstrap-css-local" href="/css/bootstrap.min.css" rel="stylesheet">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let cssCarregado = false;
            for (let i = 0; i < document.styleSheets.length; i++) {
                try {
                    let sheet = document.styleSheets[i];
                    if (sheet.href && sheet.href.indexOf("bootstrap.min.css") !== -1) {
                        if (sheet.cssRules && sheet.cssRules.length > 0) {
                            cssCarregado = true;
                            break;
                        }
                    }
                } catch (e) {
                    // Captura restrições de segurança de CORS se houverem
                }
            }

            if (!cssCarregado) {
                alert('bootstrap.min.css local não carregou. Usando CDN como reserva.');
                console.warn('bootstrap.min.css local não carregou. Usando CDN como reserva.');

                let cdn = document.createElement("link");
                cdn.rel = "stylesheet";
                cdn.href = "https://jsdelivr.net";
                cdn.integrity = "sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH";
                cdn.crossOrigin = "anonymous";
                document.head.appendChild(cdn);
            }
        });
    </script>

    <style>
      .drop-zone {
        border: 2px dashed var(--bs-border-color);
        border-radius: var(--bs-border-radius-lg);
        padding: 2rem 1rem;
        text-align: center;
        color: var(--bs-secondary-color);
        cursor: pointer;
        transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
      }
      .drop-zone:hover,
      .drop-zone.over {
        border-color: var(--bs-success);
        color: var(--bs-success);
        background-color: var(--bs-success-bg-subtle);
      }
      #preview {
        display: none;
        width: 100%;
        max-height: 360px;
        border-radius: var(--bs-border-radius);
        background: #000;
      }
    </style>
  </head>
  <body class="d-flex flex-column min-vh-100">

    <!-- //////////////////////////////////////////////////////////////////////////////////-->
    <!-- ///////      BARRA DE NAVEGAÇÃO FIXA (NAVBAR) /////////////////////////////////// -->
    <!-- //////////////////////////////////////////////////////////////////////////////////-->

    <div id="nav-sistema-placeholder"><%- include('partials/nav-sistema') %></div>
    <br><br><br>
    <!-- ///////////////////////////////////////////////////////////////////////////////// -->

    <main class="container py-4 mb-5 flex-grow-1" style="max-width: 760px;">

      <div class="card shadow-sm">
        <div class="card-header bg-success text-white py-2 px-3">
          <h1 class="h5 mb-0 fw-semibold">Conversor WebM para MP4</h1>
        </div>

        <div class="card-body p-4">
          <p class="small text-body-secondary mb-3">
            Converta gravações <strong>.webm</strong> para <strong>.mp4</strong> diretamente no navegador, sem enviar arquivos para servidores externos.
          </p>

          <!-- ÁREA DE ARRASTAR / SELECIONAR ARQUIVO -->
          <div class="drop-zone" id="drop" tabindex="0">
            Arraste seu arquivo <strong>.webm</strong> aqui ou clique para escolher
          </div>
          <input id="fi" type="file" accept="video/webm,video/*,.webm" hidden>

          <!-- PAINEL DE CONVERSÃO -->
          <div id="panel" class="card bg-body-tertiary border mt-3" hidden>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 pb-2 border-bottom">
                <strong id="fileName" class="text-break">arquivo.webm</strong>
                <span id="fileInfo" class="badge text-bg-secondary">0 KB</span>
              </div>

              <div class="row g-2 align-items-end mb-3">
                <div class="col-12 col-sm-4">
                  <label for="fps" class="form-label small mb-1">Taxa de quadros</label>
                  <select id="fps" class="form-select form-select-sm">
                    <option value="30" selected>30 fps (Padrão)</option>
                    <option value="60">60 fps (Fluido)</option>
                    <option value="24">24 fps (Leve)</option>
                  </select>
                </div>

                <div class="col-12 col-sm-4">
                  <label for="bitrate" class="form-label small mb-1">Qualidade</label>
                  <select id="bitrate" class="form-select form-select-sm">
                    <option value="5000000" selected>Alta (5 Mbps)</option>
                    <option value="2500000">Média (2.5 Mbps)</option>
                    <option value="8000000">Máxima (8 Mbps)</option>
                  </select>
                </div>

                <div class="col-12 col-sm-4 d-flex gap-2">
                  <button id="btnConvert" type="button" class="btn btn-success btn-sm w-100 fw-semibold">
                    Converter
                  </button>
                  <button id="btnSave" type="button" class="btn btn-primary btn-sm w-100 fw-semibold" hidden>
                    Salvar MP4
                  </button>
                </div>
              </div>

              <!-- BARRA DE PROGRESSO BOOTSTRAP -->
              <div id="progWrap" class="progress mb-2" style="height: 12px;" hidden>
                <div id="progBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
              </div>

              <div id="status" class="small text-body-secondary">Pronto para converter.</div>

              <video id="preview" class="mt-3 shadow-sm" controls playsinline></video>
            </div>
          </div>
        </div>
      </div>

    </main>
    <script>
    const $ = id => document.getElementById(id);
    const drop = $('drop'), fi = $('fi'), panel = $('panel'), fileNameEl = $('fileName'), fileInfoEl = $('fileInfo');
    const btnConvert = $('btnConvert'), btnSave = $('btnSave'), progWrap = $('progWrap'), progBar = $('progBar');
    const statusEl = $('status'), preview = $('preview');

    let selectedFile = null;
    let convertedBlob = null;
    let convertedName = '';

    const fmtSize = n => n > 1e6 ? (n / 1e6).toFixed(2) + ' MB' : Math.max(1, Math.ceil(n / 1e3)) + ' KB';

    function setStatus(txt, tipo = 'normal') {
      statusEl.textContent = txt;
      statusEl.className = 'small ' + (
        tipo === 'ok' ? 'text-success fw-semibold' :
        tipo === 'err' ? 'text-danger fw-semibold' :
        'text-body-secondary'
      );
    }

    function setProgress(pct, label = null) {
      progWrap.hidden = false;
      progBar.style.width = pct + '%';
      progBar.setAttribute('aria-valuenow', pct);
      progBar.textContent = label !== null ? label : (pct + '%');
    }

    function getSupportedMp4Mime() {
      const candidates = [
        'video/mp4;codecs=avc1.42E01E,mp4a.40.2',
        'video/mp4;codecs=avc1,mp4a.40.2',
        'video/mp4;codecs=avc1,opus',
        'video/mp4;codecs=h264,aac',
        'video/mp4'
      ];
      return candidates.find(m => window.MediaRecorder && MediaRecorder.isTypeSupported(m)) || null;
    }
    function loadFile(file) {
      if (!file) return;
      selectedFile = file;
      convertedBlob = null;
      convertedName = file.name.replace(/\.[^.]+$/, '') + '.mp4';

      fileNameEl.textContent = file.name;
      fileInfoEl.textContent = fmtSize(file.size);
      panel.hidden = false;
      btnSave.hidden = true;
      progWrap.hidden = true;
      setProgress(0);
      progWrap.hidden = true;
      preview.style.display = 'none';
      preview.removeAttribute('src');
      setStatus('Pronto para converter.');
    }

    drop.onclick = () => fi.click();
    drop.onkeydown = e => e.key === 'Enter' && fi.click();
    fi.onchange = e => { loadFile(e.target.files[0]); e.target.value = ''; };
    drop.ondragover = e => { e.preventDefault(); drop.classList.add('over'); };
    drop.ondragleave = () => drop.classList.remove('over');
    drop.ondrop = e => {
      e.preventDefault();
      drop.classList.remove('over');
      if (e.dataTransfer.files.length) loadFile(e.dataTransfer.files[0]);
    };

    btnSave.onclick = () => {
      if (!convertedBlob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(convertedBlob);
      a.download = convertedName;
      a.click();
    };

    btnConvert.onclick = async () => {
      if (!selectedFile) return;

      const mp4Mime = getSupportedMp4Mime();
      if (!mp4Mime) {
        setStatus('Seu navegador atual não suporta gravação nativa em MP4 (use Chrome 126+ ou Edge 126+).', 'err');
        return;
      }

      btnConvert.disabled = true;
      btnSave.hidden = true;
      setProgress(0);
      setStatus('Preparando vídeo e áudio...');

      const srcVideo = document.createElement('video');
      srcVideo.playsInline = true;
      srcVideo.preload = 'auto';
      srcVideo.style.cssText = 'position:fixed;width:1px;height:1px;opacity:0;pointer-events:none;';
      document.body.appendChild(srcVideo);
      srcVideo.src = URL.createObjectURL(selectedFile);

      let renderWorker = null;
      let audioCtx = null;

      try {
        await new Promise((resolve, reject) => {
          srcVideo.onloadeddata = resolve;
          srcVideo.onerror = () => reject(new Error('Não foi possível ler o arquivo de vídeo selecionado.'));
        });

        /* Lê a duração apenas se já estiver disponível no cabeçalho (sem dar seek no WebM) */
        const totalDuration = isFinite(srcVideo.duration) && srcVideo.duration > 0 ? srcVideo.duration : 0;
        const width = srcVideo.videoWidth || 1280;
        const height = srcVideo.videoHeight || 720;
        const fps = Number($('fps').value) || 30;
        const videoBitsPerSecond = Number($('bitrate').value) || 5000000;

        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(srcVideo, 0, 0, width, height);

        /* Captura e roteia o áudio original do WebM sem tocar alto nas caixas de som */
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        await audioCtx.resume();
        const sourceNode = audioCtx.createMediaElementSource(srcVideo);
        const destNode = audioCtx.createMediaStreamDestination();
        sourceNode.connect(destNode);

        const canvasStream = canvas.captureStream(fps);
        const tracks = [...canvasStream.getVideoTracks(), ...destNode.stream.getAudioTracks()];
        const stream = new MediaStream(tracks);

        const chunks = [];
        const recorder = new MediaRecorder(stream, { mimeType: mp4Mime, videoBitsPerSecond });
        recorder.ondataavailable = e => { if (e.data && e.data.size > 0) chunks.push(e.data); };

        const donePromise = new Promise(resolve => { recorder.onstop = resolve; });

        const intervalMs = Math.max(15, Math.round(1000 / fps));
        renderWorker = new Worker(URL.createObjectURL(new Blob([`setInterval(()=>postMessage(0),${intervalMs})`])));
        renderWorker.onmessage = () => {
          if (srcVideo.readyState >= 2) {
            ctx.drawImage(srcVideo, 0, 0, width, height);
          }
          if (totalDuration > 0) {
            const pct = Math.min(99, Math.round((srcVideo.currentTime / totalDuration) * 100));
            setProgress(pct);
            setStatus(`Convertendo para MP4... ${pct}%`);
          } else {
            setProgress(50, `${srcVideo.currentTime.toFixed(1)}s`);
            setStatus(`Convertendo para MP4... ${srcVideo.currentTime.toFixed(1)}s`);
          }
        };
        recorder.start(250);
        await srcVideo.play();

        await new Promise(resolve => { srcVideo.onended = resolve; });
        renderWorker.terminate();
        renderWorker = null;

        if (srcVideo.readyState >= 2) {
          ctx.drawImage(srcVideo, 0, 0, width, height);
        }

        if (recorder.state === 'recording') recorder.requestData();
        recorder.stop();
        await donePromise;

        await audioCtx.close();
        audioCtx = null;
        URL.revokeObjectURL(srcVideo.src);
        srcVideo.remove();

        convertedBlob = new Blob(chunks, { type: 'video/mp4' });
        if (!convertedBlob.size) {
          throw new Error('A conversão gerou um arquivo vazio (0 KB).');
        }

        const mp4Url = URL.createObjectURL(convertedBlob);
        preview.src = mp4Url;
        preview.style.display = 'block';
        btnSave.hidden = false;
        setProgress(100, '100%');
        setStatus(`Concluído! Arquivo MP4 gerado (${fmtSize(convertedBlob.size)}).`, 'ok');
      } catch (err) {
        if (renderWorker) renderWorker.terminate();
        if (audioCtx) audioCtx.close().catch(() => {});
        srcVideo.remove();
        setStatus('Erro na conversão: ' + err.message, 'err');
      } finally {
        btnConvert.disabled = false;
      }
    };
    </script>

    <!-- //////////////////////////////////////////////////////// -->
    <!-- RODAPÉ FIXO (FOOTER) -->
    <!-- //////////////////////////////////////////////////////// -->

    <div id="footer-placeholder"><%- include('partials/footer') %></div>

    <!-- /////////////////////////////////////////// -->
    <!-- DEPENDÊNCIAS DE SCRIPTS DO ECOSSISTEMA CORE -->
    <!-- /////////////////////////////////////////// -->

    <script src="/js/bootstrap.bundle.min.js"></script>

    <script>
        // Fallback estável apontando para o arquivo completo do Bootstrap JS na jsDelivr oficial
        if (typeof bootstrap === 'undefined') {
            alert('bootstrap.bundle.min.js local não carregou. Usando CDN como reserva.');
            console.warn('bootstrap.bundle.min.js local não carregou. Usando CDN como reserva.');
            document.write('<script src="https://jsdelivr.net" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"><\/script>');
        }
    </script>

    <!-- //////////////////////////////////////////////////////// -->
    <!-- INCLUDE PARA USAR HTML EXTERNO -->
    <!-- //////////////////////////////////////////////////////// -->

    <!-- //////////////////////////////////////////////////////// -->
    <!-- Script de proteção global -->
    <!-- //////////////////////////////////////////////////////// -->

  </body>
</html>
