<!doctype html>
<html lang="pt-BR" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= fornecedor.id ? 'Editar Fornecedor' : 'Cadastro de Fornecedores' %></title>
    <script src="/js/color-modes.js"></script>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100%; padding: 72px 0 56px; background: #f5f7fb; }
        [data-bs-theme="dark"] body { background: #121414; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,.08); }
        .titulo-secao { color: var(--bs-success); font-weight: 700; margin-bottom: 20px; }
        .form-label { font-weight: 600; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container-fluid">
        <div class="card card-custom border-0">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0 text-center"><%= fornecedor.id ? 'Editar Fornecedor' : 'Cadastro de Fornecedores' %></h3>
            </div>
            <div class="sticky-top bg-body pt-2 pb-2 mb-3 border-bottom">
                <div class="container-fluid d-flex flex-wrap align-items-center gap-2">
                    <a class="btn btn-sm btn-primary" href="/fornecedores/novo">🆕 Novo</a>
                    <button class="btn btn-sm btn-success" type="submit" form="formFornecedor">💾 Salvar</button>
                    <a class="btn btn-sm btn-secondary" href="/fornecedores/novo">🧹 Limpar</a>
                    <a class="btn btn-sm btn-outline-success" href="/fornecedores">📋 Tabela</a>
                    <form class="input-group input-group-sm ms-md-auto" action="/fornecedores" method="get" style="max-width:380px">
                        <input name="q" class="form-control" placeholder="Buscar razão, CNPJ, fantasia ou rua" value="<%= busca || '' %>">
                        <button class="btn btn-outline-success" type="submit">🔍</button>
                    </form>
                </div>
            </div>

            <div class="card-body">
                <% if (mensagem) { %><div class="alert alert-danger" role="alert"><%= mensagem %></div><% } %>
                <form id="formFornecedor" action="<%= fornecedor.id ? '/fornecedores/' + fornecedor.id : '/fornecedores' %>" method="post" autocomplete="off">
                    <h5 class="titulo-secao mb-3">Dados da Empresa</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="razaoSocial" class="form-label">Razão Social</label>
                            <input type="text" id="razaoSocial" name="razaoSocial" class="form-control" value="<%= fornecedor.razaoSocial || '' %>" maxlength="200" autocomplete="organization" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="cnpj" class="form-label">CNPJ</label>
                            <input type="text" id="cnpj" name="cnpj" class="form-control" value="<%= fornecedor.cnpj || '' %>" maxlength="18" placeholder="00.000.000/0000-00" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="nomeFantasia" class="form-label">Nome Fantasia</label>
                            <input type="text" id="nomeFantasia" name="nomeFantasia" class="form-control" value="<%= fornecedor.nomeFantasia || '' %>" maxlength="200">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="ie" class="form-label">Inscrição Estadual</label>
                            <input type="text" id="ie" name="ie" class="form-control" value="<%= fornecedor.ie || '' %>" maxlength="11">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="dataAbertura" class="form-label">Data de Abertura</label>
                            <input type="date" id="dataAbertura" name="dataAbertura" class="form-control" value="<%= fornecedor.dataAbertura || '' %>">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="porte" class="form-label">Porte da Empresa</label>
                            <select id="porte" name="porte" class="form-select">
                                <option value="">Selecione</option>
                                <% ['MEI', 'ME', 'EPP', 'Média', 'Grande'].forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= fornecedor.porte === opcao ? 'selected' : '' %>><%= opcao %></option>
                                <% }) %>
                                <% if (fornecedor.porte && !['MEI', 'ME', 'EPP', 'Média', 'Grande'].includes(fornecedor.porte)) { %>
                                    <option value="<%= fornecedor.porte %>" selected><%= fornecedor.porte %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="regimeTributario" class="form-label">Regime Tributário</label>
                            <select id="regimeTributario" name="regimeTributario" class="form-select">
                                <option value="">Selecione</option>
                                <% ['Simples Nacional', 'Lucro Presumido', 'Lucro Real', 'MEI'].forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= fornecedor.regimeTributario === opcao ? 'selected' : '' %>><%= opcao %></option>
                                <% }) %>
                                <% if (fornecedor.regimeTributario && !['Simples Nacional', 'Lucro Presumido', 'Lucro Real', 'MEI'].includes(fornecedor.regimeTributario)) { %>
                                    <option value="<%= fornecedor.regimeTributario %>" selected><%= fornecedor.regimeTributario %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>

                    <h5 class="titulo-secao mt-4 mb-3">Responsável / Contato</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="nomeResponsavel" class="form-label">Nome do Responsável</label>
                            <input type="text" id="nomeResponsavel" name="nomeResponsavel" class="form-control" value="<%= fornecedor.nomeResponsavel || '' %>" maxlength="200">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="cargo" class="form-label">Cargo</label>
                            <input type="text" id="cargo" name="cargo" class="form-control" value="<%= fornecedor.cargo || '' %>" maxlength="100">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="telefone" class="form-label">Telefone Comercial</label>
                            <input type="text" id="telefone" name="telefone" class="form-control" value="<%= fornecedor.telefone || '' %>" maxlength="14" placeholder="(51) 3333-3333">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="celular" class="form-label">Celular / WhatsApp</label>
                            <input type="text" id="celular" name="celular" class="form-control" value="<%= fornecedor.celular || '' %>" maxlength="16" placeholder="(51) 99999-9999">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" id="email" name="email" class="form-control" value="<%= fornecedor.email || '' %>" maxlength="254" autocomplete="email">
                        </div>
                    </div>

                    <h5 class="titulo-secao mt-4 mb-3">Endereço</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label for="cep" class="form-label">CEP</label>
                            <input type="text" id="cep" name="cep" class="form-control" value="<%= fornecedor.cep || '' %>" maxlength="9" placeholder="00000-000">
                        </div>
                        <div class="col-md-7 mb-3">
                            <label for="rua" class="form-label">Rua</label>
                            <input type="text" id="rua" name="rua" class="form-control" value="<%= fornecedor.rua || '' %>" maxlength="255">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label for="numero" class="form-label">Número</label>
                            <input type="text" id="numero" name="numero" class="form-control" value="<%= fornecedor.numero || '' %>" maxlength="40">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="bairro" class="form-label">Bairro</label>
                            <input type="text" id="bairro" name="bairro" class="form-control" value="<%= fornecedor.bairro || '' %>" maxlength="150">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="cidade" class="form-label">Cidade</label>
                            <input type="text" id="cidade" name="cidade" class="form-control" value="<%= fornecedor.cidade || '' %>" maxlength="150">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="estado" class="form-label">Estado</label>
                            <select id="estado" name="estado" class="form-select">
                                <option value="">Selecione</option>
                                <% estados.forEach(estado => { %>
                                    <option value="<%= estado %>" <%= fornecedor.estado === estado ? 'selected' : '' %>><%= estado %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="observacoes" class="form-label titulo-secao">Observações</label>
                        <textarea id="observacoes" name="observacoes" class="form-control" rows="4" maxlength="10000"><%= fornecedor.observacoes || '' %></textarea>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        const cnpjInput = document.getElementById('cnpj');
        const formFornecedor = document.getElementById('formFornecedor');

        function normalizarCNPJ(valor) {
            return valor.toUpperCase().replace(/[^A-Z0-9]/g, '');
        }

        function validarCNPJ(valor) {
            const cnpj = normalizarCNPJ(valor);
            if (!/^[A-Z0-9]{12}\d{2}$/.test(cnpj) || /^([A-Z0-9])\1+$/.test(cnpj)) return false;
            const digito = (base, pesos) => {
                const soma = [...base].reduce((total, caractere, indice) => (
                    total + (caractere.charCodeAt(0) - 48) * pesos[indice]
                ), 0);
                const resto = soma % 11;
                return resto < 2 ? 0 : 11 - resto;
            };
            return digito(cnpj.slice(0, 12), [5,4,3,2,9,8,7,6,5,4,3,2]) === Number(cnpj[12])
                && digito(cnpj.slice(0, 13), [6,5,4,3,2,9,8,7,6,5,4,3,2]) === Number(cnpj[13]);
        }

        function mascararCNPJ() {
            const cnpj = normalizarCNPJ(cnpjInput.value).slice(0, 14);
            if (cnpj.length > 12) {
                cnpjInput.value = `${cnpj.slice(0, 2)}.${cnpj.slice(2, 5)}.${cnpj.slice(5, 8)}/${cnpj.slice(8, 12)}-${cnpj.slice(12)}`;
            } else if (cnpj.length > 8) {
                cnpjInput.value = `${cnpj.slice(0, 2)}.${cnpj.slice(2, 5)}.${cnpj.slice(5, 8)}/${cnpj.slice(8)}`;
            } else if (cnpj.length > 5) {
                cnpjInput.value = `${cnpj.slice(0, 2)}.${cnpj.slice(2, 5)}.${cnpj.slice(5)}`;
            } else if (cnpj.length > 2) {
                cnpjInput.value = `${cnpj.slice(0, 2)}.${cnpj.slice(2)}`;
            } else {
                cnpjInput.value = cnpj;
            }
        }

        function mascararIE() {
            let valor = document.getElementById('ie').value.replace(/\D/g, '').slice(0, 9);
            if (valor.length > 3) valor = `${valor.slice(0, 3)}/${valor.slice(3)}`;
            document.getElementById('ie').value = valor;
        }

        function mascararTelefone() {
            let valor = document.getElementById('telefone').value.replace(/\D/g, '').slice(0, 10);
            if (valor.length > 6) valor = `(${valor.slice(0, 2)}) ${valor.slice(2, 6)}-${valor.slice(6)}`;
            else if (valor.length > 2) valor = `(${valor.slice(0, 2)}) ${valor.slice(2)}`;
            else if (valor) valor = `(${valor}`;
            document.getElementById('telefone').value = valor;
        }

        function mascararCelular() {
            let valor = document.getElementById('celular').value.replace(/\D/g, '').slice(0, 11);
            if (valor.length > 7) valor = `(${valor.slice(0, 2)}) ${valor.slice(2, 7)}-${valor.slice(7)}`;
            else if (valor.length > 2) valor = `(${valor.slice(0, 2)}) ${valor.slice(2)}`;
            else if (valor) valor = `(${valor}`;
            document.getElementById('celular').value = valor;
        }

        function mascararCEP() {
            let valor = document.getElementById('cep').value.replace(/\D/g, '').slice(0, 8);
            if (valor.length > 5) valor = `${valor.slice(0, 5)}-${valor.slice(5)}`;
            document.getElementById('cep').value = valor;
        }

        cnpjInput.addEventListener('input', mascararCNPJ);
        document.getElementById('ie').addEventListener('input', mascararIE);
        document.getElementById('telefone').addEventListener('input', mascararTelefone);
        document.getElementById('celular').addEventListener('input', mascararCelular);
        document.getElementById('cep').addEventListener('input', mascararCEP);
        formFornecedor.addEventListener('submit', event => {
            if (!validarCNPJ(cnpjInput.value)) {
                event.preventDefault();
                alert('Informe um CNPJ válido.');
            }
        });
    </script>
</body>
</html>
