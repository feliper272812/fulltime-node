      console.warn('bootstrap.bundle.min.js local não carregou. Usando CDN como reserva.');
      document.write('<script src="https://jsdelivr.net" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"><\/script>');
    }
  </script>

