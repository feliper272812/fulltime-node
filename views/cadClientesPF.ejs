<!doctype html>
<html lang="pt-BR" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= cliente.id ? 'Editar Cliente PF' : 'Cadastro de Clientes PF' %></title>
    <script src="/js/color-modes.js"></script>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100%; padding: 72px 0 56px; background: #f5f7fb; }
        [data-bs-theme="dark"] body { background: #121414; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,.08); }
        .titulo-secao { color: var(--bs-success); font-weight: 700; margin-bottom: 20px; }
        .form-label { font-weight: 600; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container-fluid">
        <div class="card card-custom border-0">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0 text-center"><%= cliente.id ? 'Editar Cliente Pessoa Física' : 'Cadastro de Clientes Pessoa Física' %></h3>
            </div>
            <div class="sticky-top bg-body pt-2 pb-2 mb-3 border-bottom">
                <div class="container-fluid d-flex flex-wrap align-items-center gap-2">
                    <a class="btn btn-sm btn-primary" href="/clientes-pf/novo">🆕 Novo</a>
                    <button class="btn btn-sm btn-success" type="submit" form="formClientePF">💾 Salvar</button>
                    <a class="btn btn-sm btn-secondary" href="/clientes-pf/novo">🧹 Limpar</a>
                    <a class="btn btn-sm btn-outline-success" href="/clientes-pf">📋 Tabela</a>
                    <form class="input-group input-group-sm ms-md-auto" action="/clientes-pf" method="get" style="max-width:380px">
                        <input name="q" class="form-control" placeholder="Buscar nome, CPF, nascimento ou rua" value="<%= busca || '' %>">
                        <button class="btn btn-outline-success" type="submit">🔍</button>
                    </form>
                </div>
            </div>

            <div class="card-body">
                <% if (mensagem) { %><div class="alert alert-danger" role="alert"><%= mensagem %></div><% } %>
                <form id="formClientePF" action="<%= cliente.id ? '/clientes-pf/' + cliente.id : '/clientes-pf' %>" method="post" autocomplete="off">
                    <h5 class="titulo-secao mb-3">Dados Pessoais</h5>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label for="nomeCompleto" class="form-label">Nome Completo</label>
                            <input type="text" id="nomeCompleto" name="nomeCompleto" class="form-control" value="<%= cliente.nomeCompleto || '' %>" placeholder="Nome completo do cliente" autocomplete="name" maxlength="200" required>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="cpf" class="form-label">CPF</label>
                            <input type="text" id="cpf" name="cpf" class="form-control" value="<%= cliente.cpf || '' %>" maxlength="14" placeholder="000.000.000-00" autocomplete="off" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="dataNascimento" class="form-label">Data de Nascimento</label>
                            <input type="date" id="dataNascimento" name="dataNascimento" class="form-control" value="<%= cliente.dataNascimento || '' %>">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="rg" class="form-label">RG</label>
                            <input type="text" id="rg" name="rg" class="form-control" value="<%= cliente.rg || '' %>" maxlength="30" placeholder="00.000.000-0">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="sexo" class="form-label">Sexo</label>
                            <select id="sexo" name="sexo" class="form-select">
                                <option value="">Selecione</option>
                                <% ['Masculino', 'Feminino', 'Outro'].forEach(opcao => { %>
                                    <option value="<%= opcao %>" <%= cliente.sexo === opcao ? 'selected' : '' %>><%= opcao %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <h5 class="titulo-secao mt-4 mb-3">Contato</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="telefone" class="form-label">Telefone Residencial</label>
                            <input type="text" id="telefone" name="telefone" class="form-control" value="<%= cliente.telefone || '' %>" maxlength="30" placeholder="(51) 3333-3333">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="celular" class="form-label">Celular</label>
                            <input type="text" id="celular" name="celular" class="form-control" value="<%= cliente.celular || '' %>" maxlength="30" placeholder="(51) 99999-9999">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" id="email" name="email" class="form-control" value="<%= cliente.email || '' %>" maxlength="254" placeholder="cliente@email.com">
                        </div>
                    </div>

                    <h5 class="titulo-secao mt-4 mb-3">Endereço</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label for="cep" class="form-label">CEP</label>
                            <input type="text" id="cep" name="cep" class="form-control" value="<%= cliente.cep || '' %>" maxlength="9" placeholder="00000-000">
                        </div>
                        <div class="col-md-7 mb-3">
                            <label for="rua" class="form-label">Rua</label>
                            <input type="text" id="rua" name="rua" class="form-control" value="<%= cliente.rua || '' %>" maxlength="255">
                        </div>
                        <div class="col-md-2 mb-3">
                            <label for="numero" class="form-label">Número</label>
                            <input type="text" id="numero" name="numero" class="form-control" value="<%= cliente.numero || '' %>" maxlength="40">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="bairro" class="form-label">Bairro</label>
                            <input type="text" id="bairro" name="bairro" class="form-control" value="<%= cliente.bairro || '' %>" maxlength="150">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="cidade" class="form-label">Cidade</label>
                            <input type="text" id="cidade" name="cidade" class="form-control" value="<%= cliente.cidade || '' %>" maxlength="150">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label for="estado" class="form-label">Estado</label>
                            <select id="estado" name="estado" class="form-select">
                                <option value="">Selecione</option>
                                <% estados.forEach(estado => { %>
                                    <option value="<%= estado %>" <%= cliente.estado === estado ? 'selected' : '' %>><%= estado %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="observacoes" class="form-label titulo-secao">Observações</label>
                        <textarea id="observacoes" name="observacoes" class="form-control" rows="4" maxlength="10000" placeholder="Digite observações adicionais..."><%= cliente.observacoes || '' %></textarea>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        const formClientePF = document.getElementById('formClientePF');
        const cpfInput = document.getElementById('cpf');

        function mascararCPF() {
            let valor = cpfInput.value.replace(/\D/g, '').slice(0, 11);
            if (valor.length > 9) valor = valor.replace(/(\d{3})(\d{3})(\d{3})(\d{1,2})/, '$1.$2.$3-$4');
            else if (valor.length > 6) valor = valor.replace(/(\d{3})(\d{3})(\d{1,3})/, '$1.$2.$3');
            else if (valor.length > 3) valor = valor.replace(/(\d{3})(\d{1,3})/, '$1.$2');
            cpfInput.value = valor;
        }

        function validarCPF(valor) {
            const cpf = valor.replace(/\D/g, '');
            if (cpf.length !== 11 || /^(\d)\1+$/.test(cpf)) return false;
            let soma = 0;
            for (let i = 0; i < 9; i++) soma += Number(cpf[i]) * (10 - i);
            let resto = soma % 11;
            const primeiro = resto < 2 ? 0 : 11 - resto;
            soma = 0;
            for (let i = 0; i < 10; i++) soma += Number(cpf[i]) * (11 - i);
            resto = soma % 11;
            const segundo = resto < 2 ? 0 : 11 - resto;
            return primeiro === Number(cpf[9]) && segundo === Number(cpf[10]);
        }

        cpfInput.addEventListener('input', mascararCPF);
        formClientePF.addEventListener('submit', event => {
            if (!validarCPF(cpfInput.value)) {
                event.preventDefault();
                alert('Informe um CPF válido.');
            }
        });
    </script>
</body>
</html>
