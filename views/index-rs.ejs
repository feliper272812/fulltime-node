<!-- ================================================================================= -->
<!-- LOGOTIPO 3D GIRANDO COMO MOEDA -->
<!-- ================================================================================= -->

<style>

  /* ========================================================================= */
  /* ÁREA CENTRAL DA MOEDA                                                     */
  /* ========================================================================= */

  .coin-container {

    /* Centraliza o conteúdo */
    display: flex;
    justify-content: center;
    align-items: center;

    /* Define profundidade 3D */
    perspective: 2200px;

    /* Espaçamento */
    margin-top: 70px;
    margin-bottom: 60px;
  }

  /* ========================================================================= */
  /* MOEDA                                                                     */
  /* ========================================================================= */

  .coin {

    /* Tamanho da moeda (janela de visualização) - ampliada de 330px para 600px.
       Em telas pequenas usa 92% da largura para não gerar rolagem lateral. */
    width: min(600px, 92vw);
    height: min(600px, 92vw);

    /* Mantém efeito 3D */
    transform-style: preserve-3d;

    /* Animação contínua */
    animation: girarMoeda 6s linear infinite;

    /* Melhora renderização */
    will-change: transform;

    /* Sombra suave */
    filter: drop-shadow(0px 10px 15px rgba(0,0,0,0.35));
  }

  /* ========================================================================= */
  /* IMAGEM DA MOEDA                                                           */
  /* ========================================================================= */

  /* Área interna centralizada: a imagem nunca é recortada */
  .coin > div {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .coin img {

    /* Estrela 100% maior (~460px numa moeda de 600px), mantendo a proporção
       e sempre inteira dentro da moeda */
    width: 77%;
    max-width: 100%;
    max-height: none;
    height: auto;

    /* CORRIGIDO: sem border-radius e sem 'cover', que cortavam as pontas da estrela */
    border-radius: 0;
    object-fit: contain;

    /* Transparência suave */
    background: transparent;
  }

  /* ========================================================================= */
  /* ANIMAÇÃO 3D                                                               */
  /* ========================================================================= */

  @keyframes girarMoeda {

    /* Início */
    0% {
      transform: rotateY(0deg);
    }

    /* Meio da rotação */
    50% {
      transform: rotateY(180deg);
    }

    /* Final */
    100% {
      transform: rotateY(360deg);
    }
  }

</style>

<!-- ========================================================================= -->
