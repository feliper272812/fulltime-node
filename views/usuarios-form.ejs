<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="auto">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= usuario.id ? 'Editar Usuário' : 'Cadastro de Usuários' %></title>
    <script>
        (() => {
            const tema = localStorage.getItem('theme') || 'auto';
            const escuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-bs-theme', tema === 'auto' ? (escuro ? 'dark' : 'light') : tema);
        })();
    </script>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100%; padding: 72px 0 56px; background: #f5f7fb; }
        [data-bs-theme="dark"] body { background: #121414; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,.08); }
        .titulo-secao { color: var(--bs-success); font-weight: 700; margin-bottom: 20px; }
        .form-label { font-weight: 600; }
        .image-box-wrapper { border: 1px solid var(--bs-border-color); border-radius: 6px; overflow: hidden; background: var(--bs-body-bg); }
        .image-box-header { background: #0f8554; color: #fff; text-align: center; font-size: 13px; padding: 8px; font-weight: 700; text-transform: uppercase; }
        .avatar-display { height: 260px; display: flex; flex-direction: column; justify-content: center; align-items: center; background: rgba(13,110,253,.04); margin: 15px; border-radius: 6px; border: 2px dashed rgba(13,110,253,.2); position: relative; overflow: hidden; }
        [data-bs-theme="dark"] .avatar-display { background: #1a222d; border-color: #2c3747; }
        .avatar-display img { width: 100%; height: 100%; object-fit: contain; position: absolute; inset: 0; z-index: 5; }
        .avatar-circle { width: 110px; height: 110px; border-radius: 50%; background: #0d6efd; display: flex; justify-content: center; align-items: center; font-size: 38px; font-weight: 700; color: #fff; margin-bottom: 15px; box-shadow: 0 4px 12px rgba(0,0,0,.15); z-index: 2; }
        .avatar-info { font-size: 14px; font-weight: 700; color: #0d6efd; text-align: center; max-width: 90%; overflow: hidden; text-overflow: ellipsis; z-index: 2; }
        [data-bs-theme="dark"] .avatar-info { color: #8bb4f8; }
        .avatar-footer { font-size: 11px; color: var(--bs-secondary-color); margin-top: 5px; text-align: center; z-index: 2; }
        .btn-action { width: 100%; padding: 8px; border: 1px solid var(--bs-border-color); background: transparent; color: var(--bs-body-color); border-radius: 4px; font-size: 13px; font-weight: 500; }
        #camera-stream { width: 100%; max-height: 320px; background: #000; border-radius: 6px; transform: scaleX(-1); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="container-fluid">
        <div class="card card-custom border-0">
            <div class="card-header bg-success text-white">
                <h3 class="mb-0 text-center"><%= usuario.id ? 'Editar Usuário' : 'Cadastro de Usuários' %></h3>
            </div>
            <div class="sticky-top bg-body pt-2 pb-2 mb-3 border-bottom">
                <div class="container-fluid d-flex flex-wrap align-items-center gap-2">
                    <a class="btn btn-sm btn-primary" href="/usuarios/novo">🆕 Novo</a>
                    <button class="btn btn-sm btn-success" type="submit" form="formUsuario">💾 Salvar</button>
                    <a class="btn btn-sm btn-secondary" href="/usuarios/novo">🧹 Limpar</a>
                    <a class="btn btn-sm btn-outline-success" href="/usuarios">📋 Tabela</a>
                    <form class="input-group input-group-sm ms-md-auto" action="/usuarios" method="get" style="max-width:380px">
                        <input name="q" class="form-control" placeholder="Pesquisar usuário" value="<%= busca || '' %>">
                        <button class="btn btn-outline-success" type="submit">🔍</button>
                    </form>
                </div>
            </div>

            <div class="card-body">
                <% if (mensagem) { %>
                    <div class="alert alert-danger" role="alert"><%= mensagem %></div>
                <% } %>
                <form id="formUsuario" action="<%= usuario.id ? '/usuarios/' + usuario.id : '/usuarios' %>" method="post" autocomplete="off">
                    <input type="hidden" name="imagem" id="imagemUsuario" value="<%= usuario.imagem || '' %>">
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <h5 class="titulo-secao mb-3">Dados de Acesso e Lotação</h5>
                            <div class="row">
                                <div class="col-md-3 mb-3">
                                    <label for="usuarioIdDisplay" class="form-label">ID</label>
                                    <input type="text" id="usuarioIdDisplay" class="form-control bg-body-secondary text-muted" value="<%= usuario.id || '(auto)' %>" disabled>
                                </div>
                                <div class="col-md-9 mb-3">
                                    <label for="usuario" class="form-label">Usuário</label>
                                    <input type="text" id="usuario" name="usuario" class="form-control" placeholder="Nome de usuário para login" autocomplete="username" value="<%= usuario.usuario || '' %>" required maxlength="100">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="senha" class="form-label">Senha</label>
                                    <input type="password" id="senha" name="senha" class="form-control" placeholder="<%= usuario.id ? 'Deixe em branco para manter a senha atual' : 'Digite a senha de acesso' %>" autocomplete="new-password" maxlength="255" <%= usuario.id ? '' : 'required' %>>
                                    <div class="form-text">A senha não é exibida. Ao editar, deixe em branco para mantê-la ou informe uma nova.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="departamento" class="form-label">Departamento</label>
                                    <input type="text" id="departamento" name="departamento" class="form-control" placeholder="Departamento / setor" value="<%= usuario.departamento || '' %>" required maxlength="100">
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4">
                            <div class="image-box-wrapper">
                                <div class="image-box-header">Imagem do Usuário</div>
                                <div class="avatar-display" id="avatarDisplayContainer">
                                    <div class="avatar-circle" id="placeholderCircle"><span id="avatarInitials">?</span></div>
                                    <div class="avatar-info" id="avatarLabel"><%= usuario.usuario || 'Novo Usuário' %></div>
                                    <div class="avatar-footer" id="avatarSubLabel"><%= usuario.departamento || 'Departamento não informado' %></div>
                                    <% if (usuario.imagem) { %><img src="<%= usuario.imagem %>" alt="Foto do usuário" id="avatarImage"><% } %>
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-2 mt-3">
                                <button type="button" class="btn-action" onclick="document.getElementById('inputArquivoFoto').click()">📷 Selecionar Imagem</button>
                                <input type="file" id="inputArquivoFoto" accept="image/png,image/jpeg,image/gif,image/webp,image/bmp" class="d-none">
                                <button type="button" class="btn-action" id="btnAbrirCamera">📹 Usar Câmera</button>
                                <div class="text-center text-muted mt-1 mb-1" id="labelNomeArquivo" style="font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                    <%= usuario.imagem ? 'Imagem salva' : 'Nenhuma foto selecionada' %>
                                </div>
                                <button type="button" class="btn-action" id="btnRemoverFoto">Remover Imagem</button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <div class="modal fade" id="modalCamera" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
            <div class="modal-header"><h5 class="modal-title fw-bold">Capturar Foto do Usuário</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
            <div class="modal-body text-center"><video id="camera-stream" autoplay playsinline></video><canvas id="snapshot-canvas" class="d-none"></canvas></div>
            <div class="modal-footer"><button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button><button type="button" class="btn btn-sm btn-success" id="btnCapturarFoto">Tirar Foto</button></div>
        </div></div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script>
        const formUsuario = document.getElementById('formUsuario');
        const inputImagem = document.getElementById('imagemUsuario');
        const containerAvatar = document.getElementById('avatarDisplayContainer');
        const inputUsuario = document.getElementById('usuario');
        const inputDepartamento = document.getElementById('departamento');
        const labelArquivo = document.getElementById('labelNomeArquivo');
        const modalCamera = new bootstrap.Modal(document.getElementById('modalCamera'));
        let fluxoVideoWebcam = null;
        let formularioAlterado = false;

        function sincronizarPreview() {
            const nome = inputUsuario.value.trim();
            const partes = nome.split(/\s+/).filter(Boolean);
            const iniciais = partes.length > 1 ? partes[0][0] + partes[partes.length - 1][0] : (partes[0] || '?')[0];
            document.getElementById('avatarLabel').textContent = nome || 'Novo Usuário';
            document.getElementById('avatarSubLabel').textContent = inputDepartamento.value.trim() || 'Departamento não informado';
            document.getElementById('avatarInitials').textContent = iniciais.toUpperCase();
        }

        function exibirImagem(dataUrl) {
            inputImagem.value = dataUrl || '';
            const imagemAtual = document.getElementById('avatarImage');
            if (imagemAtual) imagemAtual.remove();
            document.getElementById('placeholderCircle').style.display = dataUrl ? 'none' : 'flex';
            if (dataUrl) {
                const imagem = document.createElement('img');
                imagem.id = 'avatarImage';
                imagem.alt = 'Foto do usuário';
                imagem.src = dataUrl;
                containerAvatar.appendChild(imagem);
            }
        }

        document.getElementById('inputArquivoFoto').addEventListener('change', event => {
            const arquivo = event.target.files[0];
            if (!arquivo) return;
            if (!/^image\/(png|jpe?g|gif|webp|bmp)$/i.test(arquivo.type)) {
                alert('Selecione uma imagem PNG, JPEG, GIF, WebP ou BMP.');
                event.target.value = '';
                return;
            }
            const leitor = new FileReader();
            leitor.onload = () => {
                exibirImagem(leitor.result);
                labelArquivo.textContent = arquivo.name;
                formularioAlterado = true;
            };
            leitor.onerror = () => alert('Não foi possível ler a imagem selecionada.');
            leitor.readAsDataURL(arquivo);
        });

        document.getElementById('btnRemoverFoto').addEventListener('click', () => {
            exibirImagem('');
            document.getElementById('inputArquivoFoto').value = '';
            labelArquivo.textContent = 'Nenhuma foto selecionada';
            formularioAlterado = true;
        });

        document.getElementById('btnAbrirCamera').addEventListener('click', async () => {
            modalCamera.show();
            try {
                fluxoVideoWebcam = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, facingMode: 'user' } });
                document.getElementById('camera-stream').srcObject = fluxoVideoWebcam;
            } catch (erro) {
                modalCamera.hide();
                alert('Não foi possível acessar a câmera do dispositivo: ' + erro.message);
            }
        });

        document.getElementById('modalCamera').addEventListener('hidden.bs.modal', () => {
            if (fluxoVideoWebcam) {
                fluxoVideoWebcam.getTracks().forEach(track => track.stop());
                fluxoVideoWebcam = null;
            }
        });

        document.getElementById('btnCapturarFoto').addEventListener('click', () => {
            const video = document.getElementById('camera-stream');
            if (!video.videoWidth) return;
            const canvas = document.getElementById('snapshot-canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const contexto = canvas.getContext('2d');
            contexto.translate(canvas.width, 0);
            contexto.scale(-1, 1);
            contexto.drawImage(video, 0, 0, canvas.width, canvas.height);
            exibirImagem(canvas.toDataURL('image/jpeg', 0.85));
            labelArquivo.textContent = 'Captura_Webcam.jpg';
            formularioAlterado = true;
            modalCamera.hide();
        });

        [inputUsuario, inputDepartamento].forEach(campo => campo.addEventListener('input', () => {
            formularioAlterado = true;
            sincronizarPreview();
        }));
        formUsuario.addEventListener('input', () => formularioAlterado = true);
        formUsuario.addEventListener('submit', event => {
            if (!formUsuario.reportValidity()) {
                event.preventDefault();
            } else {
                formularioAlterado = false;
            }
        });
        window.addEventListener('beforeunload', event => {
            if (formularioAlterado) {
                event.preventDefault();
                event.returnValue = '';
            }
        });
        sincronizarPreview();
        if (inputImagem.value) document.getElementById('placeholderCircle').style.display = 'none';
    </script>
</body>
</html>
