<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="auto">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Usuários</title>
    <script>
        (() => {
            const tema = localStorage.getItem('theme') || 'auto';
            const escuro = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-bs-theme', tema === 'auto' ? (escuro ? 'dark' : 'light') : tema);
        })();
    </script>
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { min-height: 100%; padding: 72px 0 56px; background: #f5f7fb; }
        [data-bs-theme="dark"] body { background: #121414; }
        .card-custom { border-radius: 16px; box-shadow: 0 0 25px rgba(0,0,0,.08); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <main class="container-fluid">
        <div class="card card-custom border-0">
            <div class="card-header bg-success text-white"><h3 class="mb-0 text-center">Usuários</h3></div>
            <div class="card-body">
                <% if (mensagem) { %><div class="alert alert-success" role="status"><%= mensagem %></div><% } %>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <a class="btn btn-success" href="/usuarios/novo">🆕 Novo usuário</a>
                    <a class="btn btn-secondary" href="/usuarios<%= busca ? '?q=' + encodeURIComponent(busca) : '' %>">🔄 Atualizar</a>
                    <a class="btn btn-outline-success" href="/usuarios/exportar.csv<%= busca ? '?q=' + encodeURIComponent(busca) : '' %>">📊 Exportar CSV</a>
                    <span class="badge bg-secondary">Usuários encontrados: <%= usuarios.length %></span>
                    <form class="input-group ms-md-auto" action="/usuarios" method="get" style="max-width:380px">
                        <input name="q" class="form-control" placeholder="Pesquisar usuário" value="<%= busca || '' %>">
                        <button class="btn btn-outline-success" type="submit">🔍 Pesquisar</button>
                    </form>
                </div>
                <% if (usuarios.length === 0) { %>
                    <div class="alert alert-info mb-0">
                        Nenhum usuário encontrado. <a href="/usuarios/novo">Cadastrar usuário</a>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead><tr><th>ID</th><th>Ações</th><th>Usuário</th><th>Departamento</th></tr></thead>
                            <tbody>
                                <% usuarios.forEach(item => { %>
                                    <tr>
                                        <td><%= item.id %></td>
                                        <td class="text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary" href="/usuarios/<%= item.id %>/editar">Editar</a>
                                            <% if (usuarioLogado && Number(usuarioLogado.id) === Number(item.id)) { %>
                                                <button class="btn btn-sm btn-outline-danger" type="button" disabled title="Não é possível excluir a sessão atual">Excluir</button>
                                            <% } else { %>
                                                <form class="d-inline" action="/usuarios/<%= item.id %>/excluir" method="post" onsubmit="return confirm('Excluir este usuário?')">
                                                    <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                                                </form>
                                            <% } %>
                                        </td>
                                        <td><%= item.usuario %></td>
                                        <td><%= item.departamento || 'Geral' %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>
</html>
